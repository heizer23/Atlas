# Atlas non-secret configuration — committed to git.
# Secrets (passwords, tokens, DATA_ROOT) stay in secrets.env (gitignored).

# ── Postgres ──────────────────────────────────────────────────
ATLAS_PG_DB=atlas
ATLAS_PG_USER=atlas
ATLAS_PG_PORT=5432

# ── Service ports ─────────────────────────────────────────────
# Postgres          5432  (127.0.0.1 only)
# MCPGateway        8002  (host network)
# TaskTracker       8010  (bridge → container :8000 / run_local.py)
# WorkoutTracker    8011  (bridge → container :8000 / run_local.py)
# FoodTracker       8012  (bridge → container :8000 / run_local.py)
# Chronicle         8013  (bridge → container :8000 / run_local.py)
# Notifications     8020  (0.0.0.0 — accessible on network for Android via Tailscale)
# CalendarConnector 8021  (bridge → container :8000)
# AtlasShell        5173  (Vite dev / nginx :80 in Docker)

# ── Platform: CalendarConnector ──────────────────────────────
CALENDAR_CONNECTOR_PORT=8021

# ── Platform: Notifications ───────────────────────────────────
NOTIFICATIONS_DISPATCH_INTERVAL_SECONDS=30

# ── Platform: MCPGateway ──────────────────────────────────────
MCP_BASE_URL=https://mcp.linspad.net



# ── System: Chronos ──────────────────────────────────────
CHRONOS_PORT=18789
CHRONOS_STATE_DIR=${DATA_ROOT}/chronos
CHRONOS_WORKSPACE_DIR=${DATA_ROOT}/chronos/workspace
CHRONOS_ALLOWED_ORIGINS=http://localhost:18789,http://127.0.0.1:18789
CHRONOS_IMAGE=ghcr.io/openclaw/openclaw:latest
CHRONOS_BIND=0.0.0.0