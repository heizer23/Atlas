<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer: exclude the capture buffer (GPS/heart-rate samples, run metadata)
     and the pairing prefs (encrypted device token). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="mobile_captures.db" />
        <exclude domain="sharedpref" path="atlas_run_pairing.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="mobile_captures.db" />
        <exclude domain="sharedpref" path="atlas_run_pairing.xml" />
    </device-transfer>
</data-extraction-rules>
