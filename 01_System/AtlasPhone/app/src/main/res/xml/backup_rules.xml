<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older auto-backup. Location data (capture buffer) and the pairing prefs (Keystore-encrypted device
     token, useless on another device anyway) never leave the phone via backup. -->
<full-backup-content>
    <exclude domain="database" path="mobile_captures.db" />
    <exclude domain="sharedpref" path="atlas_run_pairing.xml" />
</full-backup-content>
